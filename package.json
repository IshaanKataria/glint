    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lucide": "^1.70.0",
    "marked": "^18.1.3"
  }
}
