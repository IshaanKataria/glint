{
  "name": "glint",
  "version": "0.1.0",
  "private": true,
  "description": "Glint: a local macOS AI overlay assistant (Electron + TypeScript)",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
